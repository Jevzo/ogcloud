{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "ignoreUnstable": true,
  "prConcurrentLimit": 10,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "One PR per ecosystem for non-major updates; majors stay separate for review",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "{{manager}} non-major"
    },
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "semanticCommitScope": "jvm"
    },
    {
      "matchManagers": ["gomod"],
      "semanticCommitScope": "go",
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "description": "The OgCloud chart's subcharts are vendored (D-0146), so their archives move with the version",
      "matchManagers": ["helmv3"],
      "semanticCommitScope": "chart",
      "postUpdateOptions": ["helmUpdateSubChartArchives"]
    },
    {
      "description": "Dependencies the chart runs move together with the images the tests run (D-0113)",
      "matchPackageNames": ["seaweedfs", "chrislusf/seaweedfs"],
      "groupName": "SeaweedFS"
    },
    {
      "matchPackageNames": ["valkey/valkey"],
      "groupName": "Valkey"
    },
    {
      "matchPackageNames": ["infisical/infisical"],
      "groupName": "Infisical"
    },
    {
      "matchManagers": ["npm"],
      "semanticCommitScope": "ts"
    },
    {
      "matchManagers": ["mise"],
      "semanticCommitScope": "tools"
    },
    {
      "description": "protoc-gen-go-grpc lives in grpc-go, whose own release tags are not its versions (D-0061)",
      "matchManagers": ["mise"],
      "matchDepNames": ["protoc-gen-go-grpc"],
      "overrideDatasource": "go",
      "overridePackageName": "google.golang.org/grpc/cmd/protoc-gen-go-grpc"
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "semanticCommitScope": "actions"
    },
    {
      "matchFileNames": ["testing/images.properties"],
      "semanticCommitType": "test",
      "semanticCommitScope": "images"
    },
    {
      "description": "The test broker follows the Kafka line Strimzi 1.3 runs (D-0021, D-0113); raise it with Strimzi",
      "matchFileNames": ["testing/images.properties"],
      "matchDepNames": ["apache/kafka"],
      "allowedVersions": "<4.4"
    }
  ],
  "customManagers": [
    {
      "description": "Third-party charts in deploy/platform-deps.yaml (D-0021); the sha256-pinned manifests are bumped by hand, CRD manifests with the charts they follow (D-0171)",
      "customType": "regex",
      "managerFilePatterns": ["/^deploy/platform-deps\\.yaml$/"],
      "matchStrings": [
        "repository: (?<registryUrl>\\S+)\\n\\s+chart: (?<depName>\\S+)\\n\\s+version: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "description": "Testcontainers images shared by the Kotlin and Go tests (D-0113)",
      "customType": "regex",
      "managerFilePatterns": ["/^testing/images\\.properties$/"],
      "matchStrings": ["[a-z0-9-]+=(?<depName>[^:\\s]+):(?<currentValue>\\S+)"],
      "datasourceTemplate": "docker"
    }
  ]
}
