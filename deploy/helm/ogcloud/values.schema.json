{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OgCloud chart values",
  "description": "Checks the values operators set; a typo in a top-level key fails instead of being ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": ["publicOrigin", "minecraft"],
  "properties": {
    "image": { "type": "object" },
    "namespaces": { "type": "object" },
    "priorityClasses": { "type": "object" },
    "servers": { "type": "object" },
    "publicOrigin": {
      "description": "The one public origin of the dashboard and the API (D-0098), e.g. https://cloud.example.com.",
      "type": "string",
      "pattern": "^https://[^/]+$"
    },
    "minecraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eulaAccepted"],
      "properties": {
        "eulaAccepted": {
          "description": "Whether the network's owner accepts the Minecraft EULA (D-0046); there is no default.",
          "type": "boolean"
        },
        "proxyOnlineMode": {
          "description": "Whether proxies authenticate players with Mojang; only private test clusters turn it off (D-0162).",
          "type": "boolean"
        }
      }
    },
    "allowedImagePrefixes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "postgres": { "$ref": "#/definitions/dependency" },
    "kafka": { "$ref": "#/definitions/dependency" },
    "valkey": {
      "allOf": [
        { "$ref": "#/definitions/dependency" },
        { "properties": { "sentinel": { "type": "boolean" } } }
      ]
    },
    "s3": {
      "allOf": [
        { "$ref": "#/definitions/dependency" },
        {
          "properties": {
            "pathStyle": { "type": "boolean" },
            "bucket": { "type": "string", "minLength": 3 }
          }
        }
      ]
    },
    "global": { "type": "object" },
    "seaweedfs": { "type": "object" },
    "networkPolicies": {
      "type": "object",
      "properties": {
        "apiServer": {
          "type": "object",
          "properties": {
            "cidrs": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "ports": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer" }
            }
          }
        },
        "externalCidrs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "externalS3Cidrs": { "type": "array", "items": { "type": "string" } },
        "mojang": { "type": "boolean" }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "otlpEndpoint": { "type": "string", "pattern": "^https?://" },
        "traceSampling": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "infisical": {
      "type": "object",
      "properties": { "replicas": { "type": "integer", "minimum": 1 } }
    },
    "certManager": { "type": "object" },
    "api": { "type": "object" },
    "controller": { "type": "object" },
    "gateway": { "type": "object" },
    "loadbalancer": {
      "type": "object",
      "properties": {
        "limits": {
          "description": "Per client address (D-0118).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "openPerAddress": { "type": "integer", "minimum": 1 },
            "newPerSecond": { "type": "integer", "minimum": 1 },
            "newBurst": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "retention": { "type": "object" },
    "edge": { "type": "object" },
    "bootstrap": { "type": "object" },
    "restore": {
      "description": "Restores a backup into a fresh install (T-0607).",
      "type": "object",
      "additionalProperties": false,
      "properties": { "fromServer": { "type": "string" } }
    },
    "backup": {
      "description": "Backups into an S3 target of their own (D-0166); the seed carries its credentials.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "serverName": { "type": "string" },
        "schedule": {
          "description": "CloudNativePG's six-field cron, seconds first.",
          "type": "string"
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": { "type": "string" },
            "region": { "type": "string" },
            "bucket": { "type": "string" },
            "cidrs": { "type": "array", "items": { "type": "string" } },
            "port": { "type": "integer" },
            "pathStyle": { "type": "boolean" }
          }
        },
        "templates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schedule": { "type": "string" },
            "resources": { "type": "object" }
          }
        }
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "gateway": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer" },
            "infisicalHost": { "type": "string" },
            "grafanaHost": { "type": "string" }
          }
        }
      }
    }
  },
  "definitions": {
    "dependency": {
      "description": "In the cluster, or an external endpoint (D-0021).",
      "type": "object",
      "properties": { "inCluster": { "type": "boolean" } }
    }
  }
}
