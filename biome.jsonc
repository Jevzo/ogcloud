{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    // Generated and drift-checked: the bake file from the runtime profile catalog (D-0139), the API client from the
    // OpenAPI contract (D-0163).
    "includes": [
      "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,jsonc}",
      "!images/docker-bake.json",
      "!packages/api-client/src/generated",
      "!packages/api-client/src/.generated-next"
    ]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
